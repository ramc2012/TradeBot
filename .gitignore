.DS_Store

# Local environment and secrets
.env
.env.*
!.env.example
credentials.json
backend/credentials.json
# ...and every dated/backup variant. `credentials.json.bak-fyers-20260812`
# was sitting untracked and NOT ignored: it carries live fyers app_id/secret/
# pin/access_token/refresh_token, upstox api_key/secret/access_token and the
# telegram bot_token, so a `git add -A` would have published working broker
# credentials to the remote.
credentials.json.*
backend/credentials.json.*

# Python caches and virtualenvs
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Node / Next.js
node_modules/
.next/
frontend/.next/
*.tsbuildinfo

# Logs and runtime state
*.log
backend/logs/
# Live runtime state — mutated by the running backend (paper books,
# journals, portfolio events, RAG bundles). Recursive globs cover all
# per-strategy subdirs (directional_options/paper, gann_tp_delta/paper,
# rag/, portfolio/, ...).
backend/runtime/**/*.json
backend/runtime/**/*.jsonl
# Top-level strategy state snapshots written by the supervisor.
backend/commodity_strategy.json
backend/nse_strategy_state.json

# Local databases and temp files
*.sqlite
*.sqlite3
*.db
tmp/
.tmp/

# Generated research and validation outputs.
# Anchored to root + backend so the unanchored `reports/` glob does NOT
# also swallow the frontend app route `frontend/src/app/reports/`
# (the Reports module added 2026-06-02).
/reports/
backend/reports/

# Coverage / build artifacts
.coverage
htmlcov/
dist/
build/

