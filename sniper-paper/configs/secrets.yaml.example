# Copy to secrets.yaml and fill in. Never commit secrets.yaml.

fyers:
  app_id: "YOUR_FYERS_APP_ID"
  secret_id: "YOUR_FYERS_SECRET_ID"
  redirect_uri: "https://your-callback-url.example.com/fyers/callback"
  # Access token rotates daily. Either:
  #   (a) populate manually after morning login, OR
  #   (b) let the runner refresh via TOTP at 08:50 IST (set totp_secret below).
  access_token: ""
  totp_secret: ""           # optional, base32-encoded TOTP secret from Fyers
  client_id: "ABC123"
  pin: "1234"

database:
  dsn: "postgresql://nomadcurie:nomadcurie@localhost:5433/nomadcurie"

redis:
  url: "redis://localhost:6379/2"
