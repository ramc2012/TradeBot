# Copy to .env and fill in. Never commit .env.
# Phase 0 does not call any live APIs, but Phase 1+ will.

# Fyers — used in Phase 1 for live data ingestion (not Phase 0)
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=
FYERS_STATIC_IP=

# Upstox — used for historical expired-instruments data
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# Zerodha — only for trade log download (manual export is preferred)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# Paths
DATA_DIR=./data
ARTIFACT_DIR=./artifacts

# Logging
LOG_LEVEL=INFO
