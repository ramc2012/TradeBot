# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://nomadcurie:nomadcurie@localhost:5432/nomadcurie
REDIS_URL=redis://localhost:6379/0

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-32-byte-hex-string-in-production

# ─── Fyers ───────────────────────────────────────────────────────────────────
FYERS_APP_ID=
FYERS_SECRET=
FYERS_REDIRECT_URI=http://localhost:8000/api/auth/fyers/callback

# ─── Upstox ──────────────────────────────────────────────────────────────────
UPSTOX_API_KEY=
UPSTOX_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/auth/upstox/callback

# ─── 5Paisa ──────────────────────────────────────────────────────────────────
FIVEPAISA_APP_NAME=
FIVEPAISA_APP_SOURCE=
FIVEPAISA_USER_ID=
FIVEPAISA_PASSWORD=
FIVEPAISA_USER_KEY=
FIVEPAISA_ENCRYPTION_KEY

# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Telegram (optional) ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
