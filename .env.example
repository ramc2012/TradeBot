# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://nomadcurie:nomadcurie@localhost:5432/nomadcurie
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=15
DATABASE_POOL_RECYCLE_SECONDS=900
REDIS_URL=redis://localhost:6379/0

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-32-byte-hex-string-in-production

# ─── Fyers ───────────────────────────────────────────────────────────────────
FYERS_APP_ID=
FYERS_SECRET=
FYERS_REDIRECT_URI=https://trade.fyers.in/api-login/redirect-uri/index.html
FYERS_PIN=

# ─── Upstox ──────────────────────────────────────────────────────────────────
UPSTOX_API_KEY=
UPSTOX_SECRET=
UPSTOX_REDIRECT_URI=https://www.google.com
UPSTOX_ANALYTICS_TOKEN=
RESEARCH_SYNC_AUTO_ENABLED=true
RESEARCH_SYNC_EMBEDDED_ENABLED=false
SECTOR_INTERACTION_DURABLE_STATE_ENABLED=false

# ─── 5Paisa ──────────────────────────────────────────────────────────────────
FIVEPAISA_APP_NAME=
FIVEPAISA_APP_SOURCE=
FIVEPAISA_USER_ID=
FIVEPAISA_PASSWORD=
FIVEPAISA_USER_KEY=
FIVEPAISA_ENCRYPTION_KEY

# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Telegram (optional) ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
